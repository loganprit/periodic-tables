{
  "name": "periodic-tables",
  "version": "1.0.0",
  "description": "Periodic Tables is a restaurant reservation system designed to manage reservations and table assignments for fine dining restaurants.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/loganprit/periodic-tables/"
  },
  "scripts": {
    "build": "pnpm --prefix front-end run build",
    "install": "pnpm concurrently \"cd ./back-end && pnpm install\" \"cd ./front-end && pnpm install\"",
    "start": "pnpm concurrently \"pnpm run start:backend\" \"pnpm run start:frontend\"",
    "start:backend": "pnpm --prefix ./back-end start",
    "start:frontend": "pnpm --prefix ./front-end start",
    "start:dev": "pnpm concurrently \"pnpm run start:dev --prefix ./back-end\" \"pnpm start --prefix ./front-end\"",
    "test": "pnpm run test:frontend && pnpm run test:backend",
    "test:backend": "pnpm test --prefix ./back-end",
    "test:frontend": "pnpm test --prefix ./front-end",
    "test:1": "pnpm exec npm-run-all -s test:1:*",
    "test:1:frontend": "pnpm --prefix ./front-end run test:1",
    "test:1:backend": "pnpm --prefix ./back-end run test:1",
    "test:2": "pnpm exec npm-run-all -s test:2:*",
    "test:2:frontend": "pnpm --prefix ./front-end run test:2",
    "test:2:backend": "pnpm --prefix ./back-end run test:2",
    "test:3": "pnpm exec npm-run-all -s test:3:*",
    "test:3:frontend": "pnpm --prefix ./front-end run test:3",
    "test:3:backend": "pnpm --prefix ./back-end run test:3",
    "test:4": "pnpm exec npm-run-all -s test:4:*",
    "test:4:frontend": "pnpm --prefix ./front-end run test:4",
    "test:4:backend": "pnpm --prefix ./back-end run test:4",
    "test:5": "pnpm exec npm-run-all -s test:5:*",
    "test:5:frontend": "pnpm --prefix ./front-end run test:5",
    "test:5:backend": "pnpm --prefix ./back-end run test:5",
    "test:6": "pnpm exec npm-run-all -s test:6:*",
    "test:6:frontend": "pnpm --prefix ./front-end run test:6",
    "test:6:backend": "pnpm --prefix ./back-end run test:6",
    "test:7": "pnpm exec npm-run-all -s test:7:*",
    "test:7:frontend": "pnpm --prefix ./front-end run test:7",
    "test:7:backend": "pnpm --prefix ./back-end run test:7",
    "test:8": "pnpm exec npm-run-all -s test:8:*",
    "test:8:frontend": "pnpm --prefix ./front-end run test:8",
    "test:8:backend": "pnpm --prefix ./back-end run test:8",
    "test:e2e": "pnpm --prefix ./front-end run test:e2e",
    "test:frontend:watch": "pnpm test --prefix ./front-end"
  },
  "keywords": [],
  "author": "Logan Pritchett",
  "license": "UNLICENSED",
  "dependencies": {
    "react-scripts": "^5.0.1"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
